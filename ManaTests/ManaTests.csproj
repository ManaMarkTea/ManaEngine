<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ManaTests</RootNamespace>
    <!-- The -gui runner opens a real WebGPU window, so it needs the native runtime beside it. -->
    <ManaCopyWebGpuNativeRuntime>true</ManaCopyWebGpuNativeRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Numerics" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManaUI\ManaUI.csproj" />
    <!-- Referenced so the suite exercises the editor's real views, not a copy of them that could drift. -->
    <ProjectReference Include="..\ManaEditor\ManaEditor.csproj" />
    <ProjectReference Include="..\Samples\TargetPractice\TargetPractice.csproj" />
    <ProjectReference Include="..\ManaLidar.Core\ManaLidar.Core.csproj" />
  </ItemGroup>

</Project>
