<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
        <!-- Lets restore compute a browser-wasm graph for RID-specific web-host ProjectReferences
          using SetTargetFramework. Doesn't change normal desktop builds. -->
    <RuntimeIdentifiers>browser-wasm</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- JSImportAttribute (ManaBrowserSettingsBridge) requires it; harmless off-browser since that whole
         file is #if MANA_BROWSER. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- See ManaGraphics.csproj. -->
    <DefineConstants Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">$(DefineConstants);MANA_BROWSER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- ManaImageCodec decodes and encodes with the public-domain Stb ports on desktop; the browser decodes
       with its own image decoder instead (ManaImageCodec.Browser.cs), so the web builds never compile them. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
  </ItemGroup>

</Project>
