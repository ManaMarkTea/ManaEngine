<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Lets restore compute a browser-wasm graph too, needed for ManaVoxel.Web's
         ProjectReferences (SetTargetFramework="...;RuntimeIdentifier=browser-wasm") to
         resolve at all; see WebPort-Plan.md M8. Doesn't change anything about how this
         project builds normally. -->
    <RuntimeIdentifiers>browser-wasm</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- JSImportAttribute (ManaBrowserSettingsBridge) requires it; harmless off-browser since that whole
         file is #if MANA_BROWSER. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- See ManaGraphics.csproj. -->
    <DefineConstants Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">$(DefineConstants);MANA_BROWSER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
