<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>browser-wasm</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Workstation GC (the default) handles this app's allocation pattern poorly: planet patch
         generation and GPU height-sample dispatches produce frequent large (Large Object Heap) arrays,
         up to ~256MB in a single dispatch, and the LOH isn't compacted by default. Server GC is built
         for high-allocation-rate workloads like this. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Declares PerMonitorV2 DPI awareness; see app.manifest for why. No effect off Windows. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embeds an icon in the exe, which is what Windows' taskbar and Start Menu tile pull from;
         without this the exe (and its Start Menu entry) shows the generic .NET/WinExe placeholder icon.
         No effect on browser-wasm or macOS; a macOS app bundle needs its own .icns wired through
         Info.plist instead, which is a separate, unbuilt-and-untested-on-this-machine piece of work. -->
    <ApplicationIcon>Assets\Icons\AppIcon.ico</ApplicationIcon>
    <!-- See ManaGraphics.csproj. -->
    <DefineConstants Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">$(DefineConstants);MANA_BROWSER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon above only embeds the exe resource; the running window's own icon is set at
         runtime (see ManaWindowIcon in ManaGraphics), which needs the file itself alongside the build. -->
    <Content Include="Assets\Icons\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Content\**\*.manaprefab;..\Content\**\*.managridpreset">
      <Link>Content\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
    <PackageReference Include="GeometRi" Version="1.5.0.8" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Stateless" Version="5.14.0" />
    <!-- Pure managed bindings, no native runtime asset at all; see ManaGraphics.csproj. -->
  </ItemGroup>

  <!-- Desktop-only native backends: no browser-wasm runtime asset exists for these. See
       Mana.csproj/ManaGraphics.csproj for the same treatment; this project redeclares the
       packages a third time rather than inheriting them. Assimp used to be here for
       MeshThumbnailCache.cs's preview render; that's SharpGLTF-backed now too, same loader
       ManaWorld.Gltf.cs uses everywhere; see that file's comment. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <PackageReference Include="Silk.NET.GLFW" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManaGraphics\ManaGraphics.csproj" SetTargetFramework="TargetFramework=net10.0;RuntimeIdentifier=$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' == 'browser-wasm'" />
    <ProjectReference Include="..\Mana\Mana.csproj" SetTargetFramework="TargetFramework=net10.0;RuntimeIdentifier=$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' == 'browser-wasm'" />
    <ProjectReference Include="..\ManaGraphics\ManaGraphics.csproj" Condition="'$(RuntimeIdentifier)' != 'browser-wasm'" />
    <ProjectReference Include="..\Mana\Mana.csproj" Condition="'$(RuntimeIdentifier)' != 'browser-wasm'" />
    <ProjectReference Include="..\ManaGeoTools\ManaGeoTools.csproj" SetTargetFramework="TargetFramework=net10.0;RuntimeIdentifier=$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' == 'browser-wasm'" />
    <ProjectReference Include="..\ManaGeoTools\ManaGeoTools.csproj" Condition="'$(RuntimeIdentifier)' != 'browser-wasm'" />
    <!-- Live scans from the phone (ScanStream, colouring, the textured export): desktop only, where there is a
         network to listen on; the browser build leaves the LiveScan code out (MANA_BROWSER). -->
    <ProjectReference Include="..\ManaLidar.Core\ManaLidar.Core.csproj" Condition="'$(RuntimeIdentifier)' != 'browser-wasm'" />
    <!-- Games in projects of their own; ManaGames.cs registers their level game modes. -->
    <ProjectReference Include="..\Games\TrainYardWars\TrainYardWars.csproj" SetTargetFramework="TargetFramework=net10.0;RuntimeIdentifier=$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' == 'browser-wasm'" />
    <ProjectReference Include="..\Games\TrainYardWars\TrainYardWars.csproj" Condition="'$(RuntimeIdentifier)' != 'browser-wasm'" />
    <ProjectReference Include="..\Games\Runner\Runner.csproj" SetTargetFramework="TargetFramework=net10.0;RuntimeIdentifier=$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' == 'browser-wasm'" />
    <ProjectReference Include="..\Games\Runner\Runner.csproj" Condition="'$(RuntimeIdentifier)' != 'browser-wasm'" />
  </ItemGroup>


</Project>
