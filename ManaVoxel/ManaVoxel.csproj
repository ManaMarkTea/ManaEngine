<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Workstation GC (the default) handles this app's allocation pattern poorly: planet patch
         generation and GPU height-sample dispatches produce frequent large (Large Object Heap) arrays,
         up to ~256MB in a single dispatch, and the LOH isn't compacted by default. Server GC is built
         for high-allocation-rate workloads like this. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Declares PerMonitorV2 DPI awareness; see app.manifest for why. No effect off Windows. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- See ManaGraphics.csproj. -->
    <DefineConstants Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">$(DefineConstants);MANA_BROWSER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
    <PackageReference Include="GeometRi" Version="1.5.0.8" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Stateless" Version="5.14.0" />
    <!-- Pure managed bindings, no native runtime asset at all; see ManaGraphics.csproj. -->
    <PackageReference Include="Silk.NET.OpenGL.Extensions.APPLE" Version="2.23.0" />
  </ItemGroup>

  <!-- Desktop-only native backends: no browser-wasm runtime asset exists for these. See
       Mana.csproj/ManaGraphics.csproj for the same treatment; this project redeclares the
       packages a third time rather than inheriting them. Silk.NET.OpenGL.Extensions.ImGui
       pulls in ImGui.NET (a native cimgui binary) transitively. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <PackageReference Include="Silk.NET.Assimp" Version="2.23.0" />
    <PackageReference Include="Silk.NET.GLFW" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManaGraphics\ManaGraphics.csproj" />
    <ProjectReference Include="..\Mana\Mana.csproj" />
    <ProjectReference Include="..\ManaGeoTools\ManaGeoTools.csproj" />
  </ItemGroup>

</Project>
