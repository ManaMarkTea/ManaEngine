  <!-- Transitional bridge: these implementations now live with the graphics
       subsystem, but still compile into Mana until their ManaContext-era
       dependencies are replaced with ManaCore contracts.
       Desktop only: the OpenGL Legacy files need the OpenGL backend, which the
       WebGPU-only browser target excludes entirely. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <Compile Include="..\ManaGraphics\Code\Graphics\OpenGL\Legacy\**\*.cs"
             Link="Code\Graphics\OpenGL\Legacy\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- GameSilkOpenGl.cs (above) calls ManaWindowIcon; Mana has no ProjectReference to
         ManaGraphics (see ManaGraphics.csproj), so the file is compiled into this assembly
         too, same as the Legacy files above. -->
    <Compile Include="..\ManaGraphics\Code\Graphics\ManaWindowIcon.cs"
             Link="Code\Graphics\ManaWindowIcon.cs" />
  </ItemGroup>

  <!-- ManaGameModeGraphicsBridge.cs is the one exception to the exclusion above; see
       ManaGraphics.csproj for why. BaseGameMode.cs (compiled into this same assembly)
       calls it directly regardless of backend. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <Compile Include="..\ManaGraphics\Code\Graphics\OpenGL\Legacy\ManaGameModeGraphicsBridge.cs"
             Link="Code\Graphics\OpenGL\Legacy\ManaGameModeGraphicsBridge.cs" />
  </ItemGroup>


