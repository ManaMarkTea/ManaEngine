    <PackageReference Include="Silk.NET.Core" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
    <PackageReference Include="Stateless" Version="5.14.0" />
    <!-- Pure managed bindings, no native runtime asset at all; see ManaGraphics.csproj. Core
         types (ManaContext, ManaTexture, ManaMaterial, ManaMesh) reference GL/GLEnum/TextureTarget
         etc. directly even though they're also usable under WebGPU (Context.OpenGl is already
         nullable and null-checked throughout for exactly that case), so excluding the package
         itself isn't needed or wanted for the browser target. -->
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL.Extensions.APPLE" Version="2.23.0" />
  </ItemGroup>

  <!-- Desktop-only native backends: no browser-wasm runtime asset exists for these.
       GLFW is desktop windowing, unused on the WebGPU-only browser target. Assimp used to be here
       too (glTF/OBJ/FBX/DAE/STL/PLY import) until ManaWorld.Gltf.cs standardized on the pure-managed
       SharpGLTF loader everywhere; see that file's own comment for why.
       Silk.NET.OpenGL.Extensions.ImGui was here as well, until the editor UI finished moving to
       ManaUI and ImGui was removed outright. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <PackageReference Include="Silk.NET.GLFW" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
  </ItemGroup>

  <!-- ManaIrradianceRenderer/ManaDeferredRenderer are only ever constructed when
       ManaWorld.Initialize's createRenderer parameter is true, which the WebGPU path
       (ManaWorld.Renderer stays null there; rendering goes through ManaWebGpuContext
       instead) never passes; confirmed via BaseGameMode.LoadForGraphicsBackend's only
       caller. Genuinely OpenGL-legacy-only, not just OpenGL-adjacent. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <Compile Remove="Code\Renderers\ManaDeferredRenderer.cs" />
    <Compile Remove="Code\Renderers\ManaIrradianceRenderer.cs" />
  </ItemGroup>

