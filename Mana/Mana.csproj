<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>browser-wasm</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- Emitted so the inspector can show a property's own doc comment as its tooltip. 1591 is the
         "missing XML comment" warning, which would otherwise fire on every undocumented public member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- See ManaGraphics.csproj. -->
    <DefineConstants Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">$(DefineConstants);MANA_BROWSER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
    <PackageReference Include="GeometRi" Version="1.5.0.8" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <PackageReference Include="Silk.NET.Core" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
    <PackageReference Include="Stateless" Version="5.14.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <PackageReference Include="Silk.NET.GLFW" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Silk.NET.Input" />
    <Using Include="System.Numerics" />
  </ItemGroup>

  <!-- The engine's own assets live in the repo's Assets/ beside the model packs; the app carries these as Assets/...
       (the rest are found in the checkout, or fetched from the catalog on the web). -->
  <ItemGroup>
    <Content Include="..\Assets\Textures\**\*" Exclude="..\Assets\Textures\**\*.exr" LinkBase="Assets\Textures" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\Audio\**\*" LinkBase="Assets\Audio" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Assets\Fonts\**\*" LinkBase="Assets\Fonts" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\Materials\**\*.zip" LinkBase="Assets\Materials" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\Models\FlightHelmet\glTF\*" LinkBase="Assets\Models\FlightHelmet\glTF" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\Models\Vox\*.vox" LinkBase="Assets\Models\Vox" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\Models\ShaderBall\ShaderBall.glb" Link="Assets\Models\ShaderBall\ShaderBall.glb" CopyToOutputDirectory="PreserveNewest" />
    <!-- The planet's height map (466 MB) is the desktop's alone. -->
    <Content Include="..\Assets\Planet\*.tif" LinkBase="Assets\Planet" CopyToOutputDirectory="PreserveNewest" Condition="'$(RuntimeIdentifier)' != 'browser-wasm'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManaAudio\ManaAudio.csproj" />
    <ProjectReference Include="..\ManaCore\ManaCore.csproj" />
    <ProjectReference Include="..\ManaPixelFx\ManaPixelFx.csproj" />
    <ProjectReference Include="..\ManaUI\ManaUI.csproj" />
  </ItemGroup>

  <!-- ManaGameModeGraphicsBridge.cs is the one exception to the exclusion above; see
       ManaGraphics.csproj for why. BaseGameMode.cs (compiled into this same assembly)
       calls it directly regardless of backend. -->


  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm'">
    <Compile Include="..\ManaGraphics\Code\Graphics\ManaWindowIcon.cs"
             Link="Code\Graphics\ManaWindowIcon.cs" />
  </ItemGroup>
</Project>
