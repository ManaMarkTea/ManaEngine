<Project>
  <!-- Only boot dependencies enter the WASM filesystem; the catalog and library are separate. -->
  <PropertyGroup>
    <!-- macOS ships python3 with no plain python; Windows installs python. -->
    <ManaPython Condition="'$(ManaPython)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">python</ManaPython>
    <ManaPython Condition="'$(ManaPython)' == ''">python3</ManaPython>
  </PropertyGroup>
  <ItemGroup>
    <WasmExtraFilesToDeploy Include="$(MSBuildThisFileDirectory)ManaAudio/Browser/mana_audio.js" Link="mana_audio.js" />
    <WasmFilesToIncludeInFileSystem Include="$(MSBuildThisFileDirectory)ManaGraphics/Assets/Shaders/WebGpu/**/*.wgsl">
      <TargetPath>Assets/Shaders/WebGpu/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </WasmFilesToIncludeInFileSystem>
    <WasmFilesToIncludeInFileSystem Include="$(MSBuildThisFileDirectory)Mana/Assets/Textures/DebugTexture_Grid.png">
      <TargetPath>Assets/Textures/DebugTexture_Grid.png</TargetPath>
    </WasmFilesToIncludeInFileSystem>
    <!-- The moon's map: small, and the sky shader wants it on its first frame. -->
    <WasmFilesToIncludeInFileSystem Include="$(MSBuildThisFileDirectory)Mana/Assets/Textures/Sky/moon_lroc_1k.jpg">
      <TargetPath>Assets/Textures/Sky/moon_lroc_1k.jpg</TargetPath>
    </WasmFilesToIncludeInFileSystem>
    <!-- No environment photo (5 MB): the sky is drawn into the reflections, and the Photo sky fetches it from the catalog. -->
    <WasmFilesToIncludeInFileSystem Include="$(MSBuildThisFileDirectory)Mana/Assets/Fonts/Roboto/Roboto-Regular.ttf;$(MSBuildThisFileDirectory)Mana/Assets/Fonts/Roboto/Roboto-Medium.ttf">
      <TargetPath>Assets/Fonts/Roboto/%(Filename)%(Extension)</TargetPath>
    </WasmFilesToIncludeInFileSystem>
    <!-- No NotoColorEmoji.ttf (10 MB): the browser draws colour emoji with its own font (ManaBrowserEmoji). -->
    <WasmFilesToIncludeInFileSystem Include="$(MSBuildThisFileDirectory)Assets/kenney_mini-characters.zip">
      <TargetPath>Assets/kenney_mini-characters.zip</TargetPath>
    </WasmFilesToIncludeInFileSystem>
    <!-- The Sample Course's player start asks for the mini-dungeon hero; without it the browser spawns whichever
         character it finds first, at the wrong scale and jump height. -->
    <WasmFilesToIncludeInFileSystem Include="$(MSBuildThisFileDirectory)Assets/kenney_mini-dungeon.zip">
      <TargetPath>Assets/kenney_mini-dungeon.zip</TargetPath>
    </WasmFilesToIncludeInFileSystem>
    <WasmFilesToIncludeInFileSystem Include="$(MSBuildThisFileDirectory)Content/Levels/**/*.manalevel">
      <TargetPath>Content/Levels/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </WasmFilesToIncludeInFileSystem>
    <WasmFilesToIncludeInFileSystem Include="$(MSBuildThisFileDirectory)Content/**/*.manaprefab;$(MSBuildThisFileDirectory)Content/**/*.managridpreset;$(MSBuildThisFileDirectory)Content/**/*.manasheet;$(MSBuildThisFileDirectory)Content/**/*.manaslice">
      <TargetPath>Content/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </WasmFilesToIncludeInFileSystem>
    <WasmExtraFilesToDeploy Include="$(MSBuildThisFileDirectory)Tools/WebAssets/asset-downloads.js" Link="asset-downloads.js" />
  </ItemGroup>
  <Target Name="ManaPublishExternalAssets" AfterTargets="_WasmGenerateAppBundle">
    <WriteLinesToFile File="$(WasmAppDir)engine-version.json"
                      Lines="{&quot;version&quot;:&quot;$(Version)&quot;,&quot;commit&quot;:&quot;$(SourceRevisionId)&quot;,&quot;buildDate&quot;:&quot;$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))&quot;,&quot;buildTime&quot;:&quot;$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))&quot;}"
                      Overwrite="true" Encoding="UTF-8" />
    <Exec Command="&quot;$(ManaPython)&quot; &quot;$(MSBuildThisFileDirectory)Tools/WebAssets/publish_assets.py&quot; --root &quot;$(MSBuildThisFileDirectory).&quot; --output &quot;$(WasmAppDir).&quot;" />
  </Target>
</Project>
