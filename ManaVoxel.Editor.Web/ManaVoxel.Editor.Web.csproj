<Project Sdk="Microsoft.NET.Sdk">

  <!-- Browser-wasm executable for the EDITOR (see WebPort-Plan.md's M9). Sibling of
       ManaVoxel.Web (play mode only): that project deliberately keeps ManaVoxel.csproj out of its
       reference graph (see its own comment on this), because at the time it was written
       ManaVoxel.csproj had no browser-wasm build to reference at all. M9 changed that; see
       ManaVoxel.csproj's own RuntimeIdentifiers/SetTargetFramework wiring; so this project
       exists to reference the real thing (VoxelEditorGameMode and everything under it) rather
       than re-linking a hand-picked subset of its files by source the way ManaVoxel.Web has to
       for play mode's handful of Content/Levels/Services types. Same "always browser-wasm, permanently
       fixed RuntimeIdentifier, never invoked two ways" reasoning as ManaVoxel.Web.csproj: nothing
       else references THIS project, so there is no RID-conditioned-restore poisoning risk here
       either. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmMainJSPath>main.js</WasmMainJSPath>
    <DefineConstants>$(DefineConstants);MANA_BROWSER</DefineConstants>
    <!-- See ManaVoxel.Web.csproj: avoids a Mono wasm interpreter crash building a native-to-interp
         trampoline for a C# delegate passed as a native callback (wgpuInstanceRequestAdapter). -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <!-- See ManaVoxel.Web.csproj: ManaLevel.Load and ManaUiWorkspaceLayout's docking-layout JSON
         both go through System.Text.Json's reflection-based path. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The trimmer can't follow that reflection (nor the Inspector's or UiMarkup's), so it warns on every
         call; the assemblies it reaches into are rooted below instead, which keeps what it needs. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- See ManaVoxel.Web.csproj's identical property for the full explanation. -->
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -sUSE_WEBGPU=1 -sDEFAULT_LIBRARY_FUNCS_TO_INCLUDE=$getWasmTableEntry</EmccExtraLDFlags>
  </PropertyGroup>

  <ItemGroup>
    <!-- ManaVoxel.csproj itself, not a hand-picked subset of its files; the whole point of M9
         was making that project compile for browser-wasm so it wouldn't need re-linking the way
         ManaVoxel.Web does. ManaGeoTools comes along transitively through it. -->
    <ProjectReference Include="..\ManaCore\ManaCore.csproj" SetTargetFramework="TargetFramework=net10.0;RuntimeIdentifier=browser-wasm" />
    <ProjectReference Include="..\Mana\Mana.csproj" SetTargetFramework="TargetFramework=net10.0;RuntimeIdentifier=browser-wasm" />
    <!-- Pinned here too: RuntimeIdentifier does not flow through Mana's own reference, so without this
         ManaAudio builds its desktop OpenAL backend and the browser silently falls back to no audio. -->
    <ProjectReference Include="..\ManaAudio\ManaAudio.csproj" SetTargetFramework="TargetFramework=net10.0;RuntimeIdentifier=browser-wasm" />
    <ProjectReference Include="..\ManaGraphics\ManaGraphics.csproj" SetTargetFramework="TargetFramework=net10.0;RuntimeIdentifier=browser-wasm" />
    <ProjectReference Include="..\ManaVoxel\ManaVoxel.csproj" SetTargetFramework="TargetFramework=net10.0;RuntimeIdentifier=browser-wasm" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same reasoning as ManaVoxel.Web.csproj: the .manalevel/docking-layout DTOs are only ever
         constructed by System.Text.Json's reflection, invisible to the trimmer. -->
    <TrimmerRootAssembly Include="ManaVoxel.Editor.Web" />
    <!-- Preserve components discovered and constructed through reflection by the editor. -->
    <TrimmerRootAssembly Include="Mana" />
    <TrimmerRootAssembly Include="ManaVoxel" />
    <!-- UiMarkup finds its element types by scanning this assembly. -->
    <TrimmerRootAssembly Include="ManaUI" />
  </ItemGroup>

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="index.html" />
    <WasmExtraFilesToDeploy Include="..\ManaGraphics\Native\mana_interop.js" Link="mana_interop.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- See ManaWebGpuContext.cs:287; redundant with the real render-scene provider
         VoxelEditorGameMode.RunWebGpu already supplies (`_renderSceneProvider != null` alone
         already enables the real mesh pipeline), kept for parity with ManaVoxel.Web.csproj and in
         case that ever changes. -->
    <WasmEnvironmentVariable Include="MANA_WEBGPU_DEMO_MESH" Value="1" />
  </ItemGroup>

  <ItemGroup>
    <!-- See ManaVoxel.Web.csproj: BepuPhysics crashes Mono's LLVM AOT compiler outright on its
         SIMD generics; interpreting just this one assembly sidesteps it. -->
    <_AOT_InternalForceInterpretAssemblies Include="BepuPhysics" />
    <_AOT_InternalForceInterpretAssemblies Include="BepuUtilities" />
  </ItemGroup>

  <Import Project="..\WebAssets.props" />

  <ItemGroup>
    <!-- Identical to ManaVoxel.Web.csproj's own copy of this block; see its comments for the full
         story (native-link items don't flow across a ProjectReference edge, only the entry
         project's own publish step runs them). Kept as an exact duplicate rather than factored out
         because MSBuild doesn't let these items live in a shared referenced project either; see
         ManaGraphics.csproj's comment on the same limitation. -->
    <NativeFileReference Include="..\ManaGraphics\Native\mana_webgpu.c" />
    <EmccExportedFunction Include="_mana_wgpuInstanceCreateSurface" />
    <EmccExportedFunction Include="_mana_request_adapter" />
    <EmccExportedFunction Include="_mana_request_device" />
    <EmccExportedFunction Include="_mana_log_shader_compilation_info" />
    <EmccExportedFunction Include="_mana_debug_readback_buffer" />
    <EmccExportedFunction Include="_mana_wgpuAdapterEnumerateFeatures" />
    <EmccExportedFunction Include="_mana_wgpuAdapterGetLimits" />
    <EmccExportedFunction Include="_mana_wgpuAdapterGetProperties" />
    <EmccExportedFunction Include="_mana_wgpuAdapterRelease" />
    <EmccExportedFunction Include="_mana_wgpuAdapterRequestDevice" />
    <EmccExportedFunction Include="_mana_wgpuBindGroupLayoutRelease" />
    <EmccExportedFunction Include="_mana_wgpuBindGroupRelease" />
    <EmccExportedFunction Include="_mana_wgpuBufferDestroy" />
    <EmccExportedFunction Include="_mana_wgpuBufferMapAsync" />
    <EmccExportedFunction Include="_mana_wgpuBufferRelease" />
    <EmccExportedFunction Include="_mana_wgpuCommandBufferRelease" />
    <EmccExportedFunction Include="_mana_wgpuCommandEncoderBeginComputePass" />
    <EmccExportedFunction Include="_mana_wgpuCommandEncoderBeginRenderPass" />
    <EmccExportedFunction Include="_mana_wgpuCommandEncoderCopyBufferToBuffer" />
    <EmccExportedFunction Include="_mana_wgpuCommandEncoderCopyTextureToTexture" />
    <EmccExportedFunction Include="_mana_wgpuCommandEncoderFinish" />
    <EmccExportedFunction Include="_mana_wgpuCommandEncoderRelease" />
    <EmccExportedFunction Include="_mana_wgpuComputePassEncoderDispatchWorkgroups" />
    <EmccExportedFunction Include="_mana_wgpuComputePassEncoderEnd" />
    <EmccExportedFunction Include="_mana_wgpuComputePassEncoderRelease" />
    <EmccExportedFunction Include="_mana_wgpuComputePassEncoderSetBindGroup" />
    <EmccExportedFunction Include="_mana_wgpuComputePassEncoderSetPipeline" />
    <EmccExportedFunction Include="_mana_wgpuComputePipelineRelease" />
    <EmccExportedFunction Include="_mana_wgpuCreateInstance" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateBindGroup" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateBindGroupLayout" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateBuffer" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateCommandEncoder" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateComputePipeline" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreatePipelineLayout" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateRenderPipeline" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateSampler" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateShaderModule" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateTexture" />
    <EmccExportedFunction Include="_mana_wgpuDeviceEnumerateFeatures" />
    <EmccExportedFunction Include="_mana_wgpuDeviceGetLimits" />
    <EmccExportedFunction Include="_mana_wgpuDeviceGetQueue" />
    <EmccExportedFunction Include="_mana_wgpuDeviceRelease" />
    <EmccExportedFunction Include="_mana_wgpuDeviceSetUncapturedErrorCallback" />
    <EmccExportedFunction Include="_mana_wgpuInstanceProcessEvents" />
    <EmccExportedFunction Include="_mana_wgpuInstanceRelease" />
    <EmccExportedFunction Include="_mana_wgpuInstanceRequestAdapter" />
    <EmccExportedFunction Include="_mana_wgpuPipelineLayoutRelease" />
    <EmccExportedFunction Include="_mana_wgpuQueueRelease" />
    <EmccExportedFunction Include="_mana_wgpuQueueSubmit" />
