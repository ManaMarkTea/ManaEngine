<Project Sdk="Microsoft.NET.Sdk">

  <!-- Browser-wasm executable for the EDITOR (see WebPort-Plan.md's M9). Sibling of
       ManaVoxel.Web (play mode only): that project deliberately keeps ManaVoxel.csproj out of its
       reference graph (see its own comment on this), because at the time it was written
       ManaVoxel.csproj had no browser-wasm build to reference at all. M9 changed that; see
       ManaVoxel.csproj's own RuntimeIdentifiers/SetTargetFramework wiring; so this project
       exists to reference the real thing (VoxelEditorGameMode and everything under it) rather
       than re-linking a hand-picked subset of its files by source the way ManaVoxel.Web has to
       for play mode's handful of Levels/Services types. Same "always browser-wasm, permanently
       fixed RuntimeIdentifier, never invoked two ways" reasoning as ManaVoxel.Web.csproj: nothing
       else references THIS project, so there is no RID-conditioned-restore poisoning risk here
       either. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmMainJSPath>main.js</WasmMainJSPath>
    <DefineConstants>$(DefineConstants);MANA_BROWSER</DefineConstants>
    <!-- See ManaVoxel.Web.csproj: avoids a Mono wasm interpreter crash building a native-to-interp
         trampoline for a C# delegate passed as a native callback (wgpuInstanceRequestAdapter). -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <!-- See ManaVoxel.Web.csproj: ManaLevel.Load and ManaUiWorkspaceLayout's docking-layout JSON
         both go through System.Text.Json's reflection-based path. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- See ManaVoxel.Web.csproj's identical property for the full explanation. -->
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -sUSE_WEBGPU=1 -sDEFAULT_LIBRARY_FUNCS_TO_INCLUDE=$getWasmTableEntry</EmccExtraLDFlags>
  </PropertyGroup>

  <ItemGroup>
    <!-- ManaVoxel.csproj itself, not a hand-picked subset of its files; the whole point of M9
         was making that project compile for browser-wasm so it wouldn't need re-linking the way
         ManaVoxel.Web does. ManaGeoTools comes along transitively through it. -->
    <ProjectReference Include="..\ManaCore\ManaCore.csproj" SetTargetFramework="TargetFramework=net10.0;RuntimeIdentifier=browser-wasm" />
    <ProjectReference Include="..\Mana\Mana.csproj" SetTargetFramework="TargetFramework=net10.0;RuntimeIdentifier=browser-wasm" />
    <ProjectReference Include="..\ManaGraphics\ManaGraphics.csproj" SetTargetFramework="TargetFramework=net10.0;RuntimeIdentifier=browser-wasm" />
    <ProjectReference Include="..\ManaVoxel\ManaVoxel.csproj" SetTargetFramework="TargetFramework=net10.0;RuntimeIdentifier=browser-wasm" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same reasoning as ManaVoxel.Web.csproj: the .manalevel/docking-layout DTOs are only ever
         constructed by System.Text.Json's reflection, invisible to the trimmer. -->
    <TrimmerRootAssembly Include="ManaVoxel.Editor.Web" />
  </ItemGroup>

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="index.html" />
    <WasmExtraFilesToDeploy Include="..\ManaGraphics\Native\mana_interop.js" Link="mana_interop.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- See ManaWebGpuContext.cs:287; redundant with the real render-scene provider
         VoxelEditorGameMode.RunWebGpu already supplies (`_renderSceneProvider != null` alone
         already enables the real mesh pipeline), kept for parity with ManaVoxel.Web.csproj and in
         case that ever changes. -->
    <WasmEnvironmentVariable Include="MANA_WEBGPU_DEMO_MESH" Value="1" />
  </ItemGroup>

  <ItemGroup>
    <!-- See ManaVoxel.Web.csproj: BepuPhysics crashes Mono's LLVM AOT compiler outright on its
         SIMD generics; interpreting just this one assembly sidesteps it. -->
    <_AOT_InternalForceInterpretAssemblies Include="BepuPhysics" />
    <_AOT_InternalForceInterpretAssemblies Include="BepuUtilities" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shaders: same as ManaVoxel.Web.csproj; Content/CopyToOutputDirectory items on
         ManaGraphics.csproj don't reach the wasm virtual filesystem; WasmFilesToIncludeInFileSystem
         is the only thing that does. -->
    <WasmFilesToIncludeInFileSystem Include="..\ManaGraphics\Assets\Shaders\WebGpu\**\*.wgsl">
      <TargetPath>Assets/Shaders/WebGpu/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </WasmFilesToIncludeInFileSystem>

    <!-- ManaEnvironmentReflectionSource.DefaultSourcePath: VoxelEditorGameMode.Load() decodes this
         unconditionally on startup (the IBL environment map), editor or play mode alike. -->
    <WasmFilesToIncludeInFileSystem Include="..\Mana\Assets\Textures\Environments\kloofendal_48d_partly_cloudy_puresky_4k.png">
      <TargetPath>Assets/Textures/Environments/kloofendal_48d_partly_cloudy_puresky_4k.png</TargetPath>
    </WasmFilesToIncludeInFileSystem>
    <!-- TextureManager's default/fallback texture; VoxelEditorGameMode.Load() loads it unconditionally
         (confirmed live via the headless Chrome probe: FileNotFoundException without it). Same file
         ManaVoxel.Web.csproj bundles for its ground quad. -->
    <WasmFilesToIncludeInFileSystem Include="..\Mana\Assets\Textures\DebugTexture_Grid.png">
      <TargetPath>Assets/Textures/DebugTexture_Grid.png</TargetPath>
    </WasmFilesToIncludeInFileSystem>

    <!-- ManaUiHost.GetFontDirectories() looks under AppContext.BaseDirectory/Assets/Fonts first,
         before falling back to OS system font directories; which don't exist in the wasm VFS, so
         this is the only source ManaUi's text rendering has here at all. ManaFontManager.ResolvePath
         is a filename search, not a font-metadata parse (grep-audited every `.FontFamily(...)` /
         `theme.FontFamilyMono`/`FontFamilyMedium` call site in ManaVoxel/Mana/ManaUI to confirm):
         exactly two family names are ever requested by name, "Roboto" (-> Roboto-Regular.ttf, also
         TextBlock's default when nothing is specified) and "Roboto-Medium" (-> Roboto-Medium.ttf).
         "RobotoMono-Regular" (UiTheme.FontFamilyMono's default) never resolves from this bundle on
         ANY platform, desktop included; no file of that exact name exists anywhere under
         Mana/Assets/Fonts, Roboto Mono not being one of the weights shipped; so it was already
         silently falling through to whatever ManaFontManager does when nothing matches (an OS
         system font if one happens to be installed, otherwise nothing), with or without this
         change; trimming the bundle down to what actually resolves regresses nothing. Barlow
         Condensed is ImGui-font-preset-only (BaseGameMode.ImGuiFonts.cs, browser-excluded), not
         referenced by ManaUi at all. 311 KB total instead of the whole tree's 10 MB. -->
    <WasmFilesToIncludeInFileSystem Include="..\Mana\Assets\Fonts\Roboto\Roboto-Regular.ttf">
      <TargetPath>Assets/Fonts/Roboto-Regular.ttf</TargetPath>
    </WasmFilesToIncludeInFileSystem>
    <WasmFilesToIncludeInFileSystem Include="..\Mana\Assets\Fonts\Roboto\Roboto-Medium.ttf">
      <TargetPath>Assets/Fonts/Roboto-Medium.ttf</TargetPath>
    </WasmFilesToIncludeInFileSystem>

    <!-- MeshAssetLibrary.Roots() walks AppContext.BaseDirectory/Assets among other candidates looking for
         *.zip mesh packs (same path ManaVoxel.Web.csproj bundles these two at, for CharacterSpawnService).
         EnsureWatching() is a no-op on MANA_BROWSER (FileSystemWatcher has no browser-wasm support), but
         Scan() itself is a plain one-time Directory.EnumerateFiles walk with no such restriction, so the
         Import panel's asset list works here as long as something is actually bundled to find, which
         nothing was until now (an empty AppContext.BaseDirectory/Assets, silently correct, just empty).
         Same two packs ManaVoxel.Web already ships, not a new asset choice. -->
    <WasmFilesToIncludeInFileSystem Include="..\Assets\kenney_mini-characters.zip">
      <TargetPath>Assets/kenney_mini-characters.zip</TargetPath>
    </WasmFilesToIncludeInFileSystem>
    <WasmFilesToIncludeInFileSystem Include="..\Assets\kenney_train-kit.zip">
      <TargetPath>Assets/kenney_train-kit.zip</TargetPath>
    </WasmFilesToIncludeInFileSystem>
  </ItemGroup>

  <ItemGroup>
