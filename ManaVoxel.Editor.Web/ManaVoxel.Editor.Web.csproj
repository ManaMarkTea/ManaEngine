  <!-- Same download-size-manifest mechanism as ManaVoxel.Web.csproj, for the same loading screen;
       see that file's comment for why _WasmGenerateAppBundle specifically. -->
  <UsingTask TaskName="ManaWriteEditorDownloadSize" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AppBundleDir ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
long total = 0;
var directory = Path.Combine(AppBundleDir, "_framework");
foreach (var file in Directory.EnumerateFiles(directory, "*", SearchOption.AllDirectories))
{
    if (file.EndsWith(".map", StringComparison.OrdinalIgnoreCase))
    {
        continue;
    }

    total += new FileInfo(file).Length;
}

File.WriteAllText(
    Path.Combine(AppBundleDir, "mana-download-size.json"),
    "{\"totalBytes\":" + total + "}");

Log.LogMessage(MessageImportance.High, "Loading screen: download total is " + total + " bytes.");
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ManaWriteEditorDownloadSizeManifest" AfterTargets="_WasmGenerateAppBundle">
    <ManaWriteEditorDownloadSize AppBundleDir="$(WasmAppDir)" />
  </Target>

</Project>
