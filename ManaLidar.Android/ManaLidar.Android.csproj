<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike: ARCore depth (Pixels have no LiDAR) to the same coloured GLB as the iPhone scanner, through ManaLidar.Core. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <ApplicationId>com.manarenderer.manalidar</ApplicationId>
    <ApplicationTitle>ManaLidar</ApplicationTitle>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vapolia.Google.ARCore" Version="1.47.1" />
    <ProjectReference Include="..\ManaLidar.Core\ManaLidar.Core.csproj" />
  </ItemGroup>

</Project>
