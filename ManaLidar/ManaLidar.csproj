<Project Sdk="Microsoft.NET.Sdk">

  <!-- iPhone LiDAR room scanner: ARKit's scene reconstruction plus camera keyframes, exported as a coloured GLB
       (ManaLidar.Core does the export) that Mana opens. Builds on a Mac with Xcode; see README.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ARKit's LiDAR mesh only exists on a device; the simulator has no ARKit at all. -->
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>

    <ApplicationTitle>ManaLidar</ApplicationTitle>
    <!-- Must be unique to your Apple team: change it (or pass -p:ApplicationId=...) if signing complains. -->
    <ApplicationId>com.manarenderer.manalidar</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AppIcon>AppIcon</AppIcon>
  </PropertyGroup>

  <ItemGroup>
    <ImageAsset Include="Resources\Assets.xcassets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManaLidar.Core\ManaLidar.Core.csproj" />
  </ItemGroup>

  <!-- The editor's measuring rules, compiled in rather than copied, so a measurement reads the same on the phone. -->
  <ItemGroup>
    <Compile Include="..\ManaEditor\Code\Measure\*.cs" LinkBase="Measure" />
  </ItemGroup>

</Project>
