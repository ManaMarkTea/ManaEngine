<Project>

  <!-- What every browser host shares (this one and the ManaGames repo's): runtime settings, native link and bundle
       targets. The importing project supplies its ProjectReferences and its entry assembly's trimmer root. -->

  <!-- One browser host selects editor or standalone play at startup. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmMainJSPath>$(MSBuildThisFileDirectory)main.js</WasmMainJSPath>
    <DefineConstants>$(DefineConstants);MANA_BROWSER</DefineConstants>
    <!-- AOT avoids the interpreter crash creating native WebGPU callback trampolines. -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <!-- Level and docking-layout JSON require reflection under trimming. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- The trimmer can't follow that reflection (nor the Inspector's or UiMarkup's), so it warns on every
         call; the assemblies it reaches into are rooted below instead, which keeps what it needs. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- Emscripten WebGPU needs this internal callback helper retained by the native linker. -->
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -sUSE_WEBGPU=1 -sDEFAULT_LIBRARY_FUNCS_TO_INCLUDE=$getWasmTableEntry</EmccExtraLDFlags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Preserve components discovered and constructed through reflection by the editor. -->
    <TrimmerRootAssembly Include="Mana" />
    <TrimmerRootAssembly Include="ManaEditor" />
    <!-- UiMarkup finds its element types by scanning this assembly. -->
    <TrimmerRootAssembly Include="ManaUI" />
  </ItemGroup>

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="$(MSBuildThisFileDirectory)index.html" Link="index.html" />
    <WasmExtraFilesToDeploy Include="$(MSBuildThisFileDirectory)touch-controls.js" Link="touch-controls.js" />
    <WasmExtraFilesToDeploy Include="$(MSBuildThisFileDirectory)..\ManaGraphics\Native\mana_interop.js" Link="mana_interop.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exercise real mesh rendering during browser validation. -->
    <WasmEnvironmentVariable Include="MANA_WEBGPU_DEMO_MESH" Value="1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bepu SIMD generics crash LLVM AOT; interpret only the physics assemblies. -->
    <_AOT_InternalForceInterpretAssemblies Include="BepuPhysics" />
    <_AOT_InternalForceInterpretAssemblies Include="BepuUtilities" />
    <!-- Only KML import reads XML here; interpreting it saves its AOT compile on every publish. -->
    <_AOT_InternalForceInterpretAssemblies Include="System.Private.Xml" />
    <_AOT_InternalForceInterpretAssemblies Include="System.Private.Xml.Linq" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\WebAssets.props" />

  <ItemGroup>
    <!-- Native-link items must live in the entry project; project references do not forward them. -->
    <NativeFileReference Include="$(MSBuildThisFileDirectory)..\ManaGraphics\Native\mana_webgpu.c" />
    <EmccExportedFunction Include="_mana_wgpuInstanceCreateSurface" />
    <EmccExportedFunction Include="_mana_request_adapter" />
    <EmccExportedFunction Include="_mana_request_device" />
    <EmccExportedFunction Include="_mana_log_shader_compilation_info" />
    <EmccExportedFunction Include="_mana_debug_readback_buffer" />
    <EmccExportedFunction Include="_mana_wgpuAdapterEnumerateFeatures" />
    <EmccExportedFunction Include="_mana_wgpuAdapterGetLimits" />
    <EmccExportedFunction Include="_mana_wgpuAdapterGetProperties" />
    <EmccExportedFunction Include="_mana_wgpuAdapterRelease" />
    <EmccExportedFunction Include="_mana_wgpuAdapterRequestDevice" />
    <EmccExportedFunction Include="_mana_wgpuBindGroupLayoutRelease" />
    <EmccExportedFunction Include="_mana_wgpuBindGroupRelease" />
    <EmccExportedFunction Include="_mana_wgpuBufferDestroy" />
    <EmccExportedFunction Include="_mana_wgpuBufferMapAsync" />
    <EmccExportedFunction Include="_mana_wgpuBufferRelease" />
    <EmccExportedFunction Include="_mana_wgpuCommandBufferRelease" />
    <EmccExportedFunction Include="_mana_wgpuCommandEncoderBeginComputePass" />
    <EmccExportedFunction Include="_mana_wgpuCommandEncoderBeginRenderPass" />
    <EmccExportedFunction Include="_mana_wgpuCommandEncoderCopyBufferToBuffer" />
    <EmccExportedFunction Include="_mana_wgpuCommandEncoderCopyTextureToTexture" />
    <EmccExportedFunction Include="_mana_wgpuCommandEncoderFinish" />
    <EmccExportedFunction Include="_mana_wgpuCommandEncoderRelease" />
    <EmccExportedFunction Include="_mana_wgpuComputePassEncoderDispatchWorkgroups" />
    <EmccExportedFunction Include="_mana_wgpuComputePassEncoderEnd" />
    <EmccExportedFunction Include="_mana_wgpuComputePassEncoderRelease" />
    <EmccExportedFunction Include="_mana_wgpuComputePassEncoderSetBindGroup" />
    <EmccExportedFunction Include="_mana_wgpuComputePassEncoderSetPipeline" />
    <EmccExportedFunction Include="_mana_wgpuComputePipelineRelease" />
    <EmccExportedFunction Include="_mana_wgpuCreateInstance" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateBindGroup" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateBindGroupLayout" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateBuffer" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateCommandEncoder" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateComputePipeline" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreatePipelineLayout" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateRenderPipeline" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateSampler" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateShaderModule" />
    <EmccExportedFunction Include="_mana_wgpuDeviceCreateTexture" />
    <EmccExportedFunction Include="_mana_wgpuDeviceEnumerateFeatures" />
    <EmccExportedFunction Include="_mana_wgpuDeviceGetLimits" />
    <EmccExportedFunction Include="_mana_wgpuDeviceGetQueue" />
    <EmccExportedFunction Include="_mana_wgpuDeviceRelease" />
    <EmccExportedFunction Include="_mana_wgpuDeviceSetUncapturedErrorCallback" />
    <EmccExportedFunction Include="_mana_wgpuInstanceProcessEvents" />
    <EmccExportedFunction Include="_mana_wgpuInstanceRelease" />
    <EmccExportedFunction Include="_mana_wgpuInstanceRequestAdapter" />
    <EmccExportedFunction Include="_mana_wgpuPipelineLayoutRelease" />
    <EmccExportedFunction Include="_mana_wgpuQueueRelease" />
    <EmccExportedFunction Include="_mana_wgpuQueueSubmit" />
    <EmccExportedFunction Include="_mana_wgpuQueueWriteBuffer" />
    <EmccExportedFunction Include="_mana_wgpuQueueWriteTexture" />
    <EmccExportedFunction Include="_mana_wgpuRenderPassEncoderDraw" />
    <EmccExportedFunction Include="_mana_wgpuRenderPassEncoderDrawIndexed" />
    <EmccExportedFunction Include="_mana_wgpuRenderPassEncoderEnd" />
    <EmccExportedFunction Include="_mana_wgpuRenderPassEncoderRelease" />
    <EmccExportedFunction Include="_mana_wgpuRenderPassEncoderSetBindGroup" />
    <EmccExportedFunction Include="_mana_wgpuRenderPassEncoderSetIndexBuffer" />
    <EmccExportedFunction Include="_mana_wgpuRenderPassEncoderSetPipeline" />
    <EmccExportedFunction Include="_mana_wgpuRenderPassEncoderSetScissorRect" />
    <EmccExportedFunction Include="_mana_wgpuRenderPassEncoderSetVertexBuffer" />
    <EmccExportedFunction Include="_mana_wgpuRenderPipelineRelease" />
    <EmccExportedFunction Include="_mana_wgpuRenderPipelineGetBindGroupLayout" />
    <EmccExportedFunction Include="_mana_wgpuSamplerRelease" />
    <EmccExportedFunction Include="_mana_wgpuShaderModuleRelease" />
    <EmccExportedFunction Include="_mana_wgpuSurfaceConfigure" />
    <EmccExportedFunction Include="_mana_wgpuSurfaceGetCurrentTexture" />
    <EmccExportedFunction Include="_mana_wgpuSurfaceGetPreferredFormat" />
    <EmccExportedFunction Include="_mana_wgpuSurfacePresent" />
    <EmccExportedFunction Include="_mana_wgpuSurfaceRelease" />
    <EmccExportedFunction Include="_mana_wgpuSurfaceUnconfigure" />
    <EmccExportedFunction Include="_mana_wgpuTextureCreateView" />
    <EmccExportedFunction Include="_mana_wgpuTextureDestroy" />
    <EmccExportedFunction Include="_mana_wgpuTextureRelease" />
    <EmccExportedFunction Include="_mana_wgpuTextureViewRelease" />
  </ItemGroup>

  <!-- Measure the completed bundle for byte-based loading progress. -->
  <UsingTask TaskName="ManaWriteEditorDownloadSize" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AppBundleDir ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
long total = 0;
var directory = Path.Combine(AppBundleDir, "_framework");
foreach (var file in Directory.EnumerateFiles(directory, "*", SearchOption.AllDirectories))
{
    if (file.EndsWith(".map", StringComparison.OrdinalIgnoreCase))
    {
        continue;
    }

    total += new FileInfo(file).Length;
}

File.WriteAllText(
    Path.Combine(AppBundleDir, "mana-download-size.json"),
    "{\"totalBytes\":" + total + "}");

Log.LogMessage(MessageImportance.High, "Loading screen: download total is " + total + " bytes.");
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ManaWriteEditorDownloadSizeManifest" AfterTargets="_WasmGenerateAppBundle">
    <ManaWriteEditorDownloadSize AppBundleDir="$(WasmAppDir)" />
  </Target>

</Project>
