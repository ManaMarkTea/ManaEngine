  </ItemGroup>

  <!-- Measure the completed bundle for byte-based loading progress. -->
  <UsingTask TaskName="ManaWriteEditorDownloadSize" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AppBundleDir ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
long total = 0;
var directory = Path.Combine(AppBundleDir, "_framework");
foreach (var file in Directory.EnumerateFiles(directory, "*", SearchOption.AllDirectories))
{
    if (file.EndsWith(".map", StringComparison.OrdinalIgnoreCase))
    {
        continue;
    }

    total += new FileInfo(file).Length;
}

File.WriteAllText(
    Path.Combine(AppBundleDir, "mana-download-size.json"),
    "{\"totalBytes\":" + total + "}");

Log.LogMessage(MessageImportance.High, "Loading screen: download total is " + total + " bytes.");
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ManaWriteEditorDownloadSizeManifest" AfterTargets="_WasmGenerateAppBundle">
    <ManaWriteEditorDownloadSize AppBundleDir="$(WasmAppDir)" />
  </Target>



  <!-- The hosted browser app is AppBundle, populated only by WasmFilesToIncludeInFileSystem above.
       The generic SDK publish/target directories can still collect referenced-project desktop content
       from Mana.csproj's ordinary CopyToOutputDirectory items. Keep the full ETOPO baseline available
       to desktop builds, but never leave this 444 MB source GeoTIFF in editor-web outputs that people
       are likely to zip for itch.io. -->
  <Target Name="ManaRemoveOversizedDesktopPlanetAssetFromEditorWebOutputs" AfterTargets="Build;Publish">
    <ItemGroup>
      <_ManaEditorWebOversizedDesktopAsset Include="$(TargetDir)Assets\Planet\ETOPO_2022_v1_60s_N90W180_surface.tif"
                                           Condition="Exists('$(TargetDir)Assets\Planet\ETOPO_2022_v1_60s_N90W180_surface.tif')" />
      <_ManaEditorWebOversizedDesktopAsset Include="$(PublishDir)Assets\Planet\ETOPO_2022_v1_60s_N90W180_surface.tif"
                                           Condition="'$(PublishDir)' != '' And Exists('$(PublishDir)Assets\Planet\ETOPO_2022_v1_60s_N90W180_surface.tif')" />
    </ItemGroup>
    <Delete Files="@(_ManaEditorWebOversizedDesktopAsset)" />
  </Target>

</Project>
