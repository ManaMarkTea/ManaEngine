{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "stop active Mana debug session",
      "type": "process",
      "command": "sh",
      "args": [
        "-c",
        "exit 0"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/.vscode/stop-active-debug.ps1"
        ]
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },
    {
      "label": "build Mana",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Mana/Mana.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build Mana (debug launch)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Mana/Mana.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build ManaVoxel",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/ManaVoxel/ManaVoxel.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build ManaVoxel (debug launch)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/ManaVoxel/ManaVoxel.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build Mana solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Mana/Mana.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
