{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated",
    "clear": true
  },
  "tasks": [
    {
      "label": "Build: choose project...",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/${input:project}",
        "--configuration",
        "${input:configuration}",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "detail": "Select a project or desktop solution and Debug/Release."
    },
    {
      "label": "Clean: choose project...",
      "type": "process",
      "command": "dotnet",
      "args": [
        "clean",
        "${workspaceFolder}/${input:project}",
        "--configuration",
        "${input:configuration}",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "detail": "Select a project or desktop solution and Debug/Release."
    },
    {
      "label": "Clean build: choose project...",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/${input:project}",
        "--configuration",
        "${input:configuration}",
        "--nologo",
        "-t:Rebuild"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "detail": "Select a project or desktop solution and Debug/Release. Cleans and rebuilds its dependencies."
    },
    {
      "label": "Build: ManaEditor (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/ManaEditor/ManaEditor.csproj",
        "-c",
        "Debug",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build: ManaTests (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/ManaTests/ManaTests.csproj",
        "-c",
        "Debug",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Run: ManaEditor",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/ManaEditor/ManaEditor.csproj",
        "-c",
        "${input:configuration}",
        "--"
      ],
      "problemMatcher": "$msCompile",
      "detail": "Builds and runs the desktop app with WebGPU."
    },
    {
      "label": "Deploy: ManaLidar to iPhone",
      "type": "process",
      "command": "${workspaceFolder}/Tools/ManaLidar/deploy-ios.sh",
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}/Tools/ManaLidar/deploy-ios-from-windows.ps1",
          "-App",
          "ManaLidar",
          "-Configuration",
          "${input:configuration}"
        ]
      },
      "args": [
        "${input:configuration}"
      ],
      "problemMatcher": "$msCompile",
      "detail": "Builds, installs and launches ManaLidar on the iPhone. Windows automatically deploys committed HEAD through the Mac over SSH; commit app changes first."
    },
    {
      "label": "Deploy: ManaLidar to iPhone (from Windows, via the Mac)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/Tools/ManaLidar/deploy-ios-from-windows.ps1",
        "-Configuration",
        "${input:configuration}"
      ],
      "problemMatcher": "$msCompile",
      "detail": "Windows: sends committed HEAD directly to a separate deploy copy on the Mac over SSH, then builds, installs and launches ManaLidar. Commit app changes first. Remote Login must be on; the phone must be paired with the Mac."
    },
    {
      "label": "Deploy: ManaEditor to iPhone",
      "type": "process",
      "command": "${workspaceFolder}/Tools/ManaLidar/deploy-ios.sh",
      "args": [
        "${input:configuration}"
      ],
      "options": {
        "env": {
          "APP": "ManaEditor.iOS"
        }
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}/Tools/ManaLidar/deploy-ios-from-windows.ps1",
          "-App",
          "ManaEditor.iOS",
          "-Configuration",
          "${input:configuration}"
        ]
      },
      "problemMatcher": "$msCompile",
      "detail": "Builds, installs and launches ManaEditor on the iPhone. Windows automatically deploys committed HEAD through the Mac over SSH; commit app changes first."
    },
    {
      "label": "Deploy: ManaEditor to iPhone (from Windows, via the Mac)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/Tools/ManaLidar/deploy-ios-from-windows.ps1",
        "-App",
        "ManaEditor.iOS",
        "-Configuration",
        "${input:configuration}"
      ],
      "problemMatcher": "$msCompile",
      "detail": "Windows: sends committed HEAD directly to a separate deploy copy on the Mac over SSH, then builds, installs and launches ManaEditor. Commit app changes first. Remote Login must be on; the phone must be paired with the Mac."
    },
    {
      "label": "Run: ManaTests",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/ManaTests/ManaTests.csproj",
        "-c",
        "${input:configuration}"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Run: ManaTests GUI",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/ManaTests/ManaTests.csproj",
        "-c",
        "${input:configuration}",
        "--",
        "-gui"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "Publish: ManaEditor.Web (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/ManaEditor.Web/ManaEditor.Web.csproj",
        "-c",
        "Release",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Serve: ManaEditor.Web (existing publish)",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "-u",
        "${workspaceFolder}/ManaEditor.Web/serve.py",
        "8000"
      ],
      "problemMatcher": [],
      "detail": "Serve existing output at http://localhost:8000; terminate the task to stop."
    },
    {
      "label": "Run: ManaEditor.Web",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "-u",
        "${workspaceFolder}/ManaEditor.Web/serve.py",
        "8000"
      ],
      "problemMatcher": [],
      "detail": "Publish Release, then serve at http://localhost:8000. Open the URL in your browser.",
      "dependsOn": "Publish: ManaEditor.Web (Release)",
      "dependsOrder": "sequence"
    },
    {
      "label": "Publish: ManaEditor.Editor.Web (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/ManaEditor.Web/ManaEditor.Web.csproj",
        "-c",
        "Release",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Serve: ManaEditor.Editor.Web (existing publish)",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "-u",
        "${workspaceFolder}/ManaEditor.Editor.Web/serve.py",
        "8002"
      ],
      "problemMatcher": [],
      "detail": "Serve the combined editor at http://localhost:8002/?mode=editor; terminate the task to stop."
    },
    {
      "label": "Run: ManaEditor.Editor.Web",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "-u",
        "${workspaceFolder}/ManaEditor.Editor.Web/serve.py",
        "8002"
      ],
      "problemMatcher": [],
      "detail": "Publish Release, then serve at http://localhost:8002/?mode=editor. Open the URL in your browser.",
      "dependsOn": "Publish: ManaEditor.Editor.Web (Release)",
      "dependsOrder": "sequence"
    },
    {
      "label": "Build: AudioSmoke.Web (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Tools/AudioSmoke.Web/AudioSmoke.Web.csproj",
        "-c",
        "Debug",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "hide": true
    },
    {
      "label": "Run: AudioSmoke.Web",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "-u",
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1",
        "--directory",
        "${workspaceFolder}/Artifacts/Bin/AudioSmoke.Web/Debug/net10.0/browser-wasm/AppBundle"
      ],
      "dependsOn": "Build: AudioSmoke.Web (Debug)",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "detail": "Build and serve the browser audio harness at http://localhost:8766."
    },
    {
      "label": "Run: ThumbnailBaker",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/Tools/ThumbnailBaker/ThumbnailBaker.csproj",
        "-c",
        "${input:configuration}",
        "--",
        "--app-bundle",
        "${input:appBundle}"
      ],
      "problemMatcher": "$msCompile",
      "detail": "Bake thumbnails into an existing published AppBundle."
    }
  ],
  "inputs": [
    {
      "id": "project",
      "type": "pickString",
      "description": "Project or solution",
      "options": [
        {
          "label": "Desktop solution",
          "value": "ManaRenderer.sln"
        },
        {
          "label": "ManaEditor",
          "value": "ManaEditor/ManaEditor.csproj"
        },
        {
          "label": "ManaTests",
          "value": "ManaTests/ManaTests.csproj"
        },
        {
          "label": "Mana",
          "value": "Mana/Mana.csproj"
        },
        {
          "label": "ManaCore",
          "value": "ManaCore/ManaCore.csproj"
        },
        {
          "label": "ManaGraphics",
          "value": "ManaGraphics/ManaGraphics.csproj"
        },
        {
          "label": "ManaUI",
          "value": "ManaUI/ManaUI.csproj"
        },
        {
          "label": "ManaAudio",
          "value": "ManaAudio/ManaAudio.csproj"
        },
        {
          "label": "ManaGeoTools",
          "value": "ManaGeoTools/ManaGeoTools.csproj"
        },
        {
          "label": "ManaEditor.Web",
          "value": "ManaEditor.Web/ManaEditor.Web.csproj"
        },
        {
          "label": "ManaEditor.Editor.Web",
          "value": "ManaEditor.Web/ManaEditor.Web.csproj"
        },
        {
          "label": "Tools/AudioSmoke.Web",
          "value": "Tools/AudioSmoke.Web/AudioSmoke.Web.csproj"
        },
        {
          "label": "Tools/ThumbnailBaker",
          "value": "Tools/ThumbnailBaker/ThumbnailBaker.csproj"
        }
      ],
      "default": "ManaEditor/ManaEditor.csproj"
    },
    {
      "id": "configuration",
      "type": "pickString",
      "description": "Build configuration",
      "options": [
        "Debug",
        "Release"
      ],
      "default": "Debug"
    },
    {
      "id": "appBundle",
      "type": "promptString",
      "description": "Path to an existing published AppBundle",
      "default": "Artifacts/Bin/ManaEditor.Web/Release/net10.0/browser-wasm/AppBundle"
    }
  ]
}
