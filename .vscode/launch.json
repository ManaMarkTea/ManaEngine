{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Launch Mana",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Mana (debug launch)",
      "program": "${workspaceFolder}/Mana/bin/Debug/net10.0/Mana.dll",
      "cwd": "${workspaceFolder}/Mana",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Launch Mana WebGPU",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build ManaVoxel (debug launch)",
      "program": "${workspaceFolder}/ManaVoxel/bin/Debug/net10.0/ManaVoxel.dll",
      "args": [
        "--webgpu"
      ],
      "env": {
        "MANA_WEBGPU_DEMO_MESH": "1"
      },
      "cwd": "${workspaceFolder}/ManaVoxel",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Launch ManaVoxel",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build ManaVoxel (debug launch)",
      "program": "${workspaceFolder}/ManaVoxel/bin/Debug/net10.0/ManaVoxel.dll",
      "cwd": "${workspaceFolder}/ManaVoxel",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Launch ManaVoxel WebGPU",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build ManaVoxel (debug launch)",
      "program": "${workspaceFolder}/ManaVoxel/bin/Debug/net10.0/ManaVoxel.dll",
      "args": [
        "--webgpu"
      ],
      "env": {
        "MANA_WEBGPU_DEMO_MESH": "1"
      },
      "cwd": "${workspaceFolder}/ManaVoxel",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ],
  "compounds": [
    {
      "name": "Launch Both",
      "configurations": [
        "Launch ManaVoxel",
        "Launch ManaVoxel WebGPU"
      ]
    }
  ]
}
