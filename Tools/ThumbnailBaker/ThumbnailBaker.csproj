<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ThumbnailBaker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Numerics" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plain reference, no RuntimeIdentifier override: this needs the ordinary desktop-targeted
         ManaEditor assembly (MeshThumbnailCache, ManaSharpGltfLoader, the CPU rasterizer), the same one
         ManaTests already builds against for its own headless mesh/thumbnail suites. Never published
         itself; run offline off a source build by Tools/WebAssets/bake_thumbnails.py. -->
    <ProjectReference Include="..\..\ManaEditor\ManaEditor.csproj" />
  </ItemGroup>

</Project>
